<owl:NamedIndividual rdf:about="#IPCM_Online_System">
  <rdf:type rdf:resource="#DigitalTool"/>
  <hasURL rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://commons-repo.github.io/002-research/</hasURL>
  <hasDocumentation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://commons-repo.github.io/002-research/</hasDocumentation>
  <toolDefinition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Interactive human-guided platform for generating and transforming ordered point representations.</toolDefinition>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#OpenSCAD_Template">
  <rdf:type rdf:resource="#DigitalTool"/>
  <hasURL rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://commons-repo.github.io/002-research/documents/rendering%20layer-related/openscad_template.scad</hasURL>
  <hasDocumentation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://commons-repo.github.io/002-research/documents/rendering%20layer-related/openscad_template_documentation.pdf</hasDocumentation>
  <toolDefinition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">OpenSCAD rendering template for transforming ordered point representations into two-dimensional and three-dimensional CAD assets.</toolDefinition>
</owl:NamedIndividual>

